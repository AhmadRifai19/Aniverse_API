# Copy ke .env dan isi di Vercel (jangan commit .env)
# DATABASE_URL pakai pooler Supabase port 6543 (sama kayak anime-stream)
DATABASE_URL="postgresql://postgres.xxx:password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Standalone — langsung ke otakudesu.blog tanpa otakudesu-be perantara
# OTAKUDESU_BASE_URL opsional, default sudah https://otakudesu.blog/
OTAKUDESU_BASE_URL="https://otakudesu.blog/"
CRON_SECRET="ganti-dengan-random-string-32-char"
# Mode ringan per jam: 25 = 1 halaman (cron 0 * * * * window 60)
SCAN_LIMIT="25"
WINDOW_MINUTES="60"
